# WebSocket endpoint of your VendorDAO node (public, safe to expose to the browser).
NEXT_PUBLIC_CHAIN_WS_ENDPOINT=ws://127.0.0.1:9944

# Server-only secret used by src/app/api/translate/route.ts. Get a key from
# https://console.cloud.google.com/apis/credentials after enabling the Cloud
# Translation API. NEVER prefix this with NEXT_PUBLIC_ - it must stay server-side.
GOOGLE_TRANSLATE_API_KEY=

# HMAC signing secret for the vendor email-verification tokens (captcha + email code flow,
# see src/lib/server/verificationToken.ts). Set a long random value in production - if unset,
# a hardcoded insecure fallback is used, which is fine for local/demo use only.
VENDOR_VERIFICATION_SECRET=

# Optional SMTP config for actually emailing verification codes (src/lib/server/mailer.ts).
# If SMTP_HOST is left unset, the code is returned directly in the API response instead (shown
# in the UI as a "dev code") so the flow is testable without a real mail server.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=VendorDAO <no-reply@vendordao.example>
