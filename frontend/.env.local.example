# WebSocket endpoint of your VendorDAO node (public, safe to expose to the browser).
NEXT_PUBLIC_CHAIN_WS_ENDPOINT=ws://127.0.0.1:9944

# Server-only secret used by src/app/api/translate/route.ts. Get a key from
# https://console.cloud.google.com/apis/credentials after enabling the Cloud
# Translation API. NEVER prefix this with NEXT_PUBLIC_ - it must stay server-side.
GOOGLE_TRANSLATE_API_KEY=

# HMAC signing secret for the vendor email-verification tokens (captcha + email code flow,
# see src/lib/server/verificationToken.ts). Set a long random value in production - if unset,
# a hardcoded insecure fallback is used, which is fine for local/demo use only.
VENDOR_VERIFICATION_SECRET=

# Optional SMTP config for actually emailing verification codes (src/lib/server/mailer.ts).
# If SMTP_HOST is left unset, the code is returned directly in the API response instead (shown
# in the UI as a "dev code") so the flow is testable without a real mail server.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=VendorDAO <no-reply@vendordao.example>

# Stripe stake ramp ($1 = 1 VDAO). Create a key at https://dashboard.stripe.com/apikeys and a
# webhook endpoint (POST /api/stake/webhook) at https://dashboard.stripe.com/webhooks to get the
# signing secret. If STRIPE_SECRET_KEY is unset, /stake shows a "not configured" notice instead
# of a checkout button (demo mode never needs Stripe - it simulates staking locally).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# The account that src/app/api/stake/webhook/route.ts signs the `stakeMint` extrinsic with, once
# a Stripe payment is confirmed. Must match the chain's `PaymentGatewayAccounts` (see
# chain/runtime/src/configs/mod.rs) - defaults there to the well-known --dev/--local "Dave"
# account, so the matching seed for local development is "//Dave". Use a real, dedicated
# account's seed/URI for any real deployment.
PAYMENT_GATEWAY_SEED=//Dave

# Stripe Identity, used by /kyc (src/app/api/kyc/*) for real document + selfie identity
# verification before a resident requests ward-scoped voting rights. Reuses STRIPE_SECRET_KEY
# above (enable "Identity" in your Stripe dashboard - https://dashboard.stripe.com/identity).
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY is loaded in the browser by @stripe/stripe-js, so it must
# stay prefixed with NEXT_PUBLIC_ (it is safe to expose - it cannot move funds or read data on
# its own). If either key is unset, /kyc falls back to a self-attested ward declaration that
# still requires city admin review (vendorDao.setKycStatus) before it's usable for voting.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Google Maps JavaScript API, used by src/components/VendorMap.tsx (vendor locations on /map).
# Create a key at https://console.cloud.google.com/google/maps-apis/credentials (enable "Maps
# JavaScript API" and "Geocoding API"), then restrict it to your domain(s). This key is loaded
# directly in the browser (that's how the Google Maps JS API works), so it must be prefixed with
# NEXT_PUBLIC_ - restrict it by HTTP referrer in the Cloud Console instead of keeping it secret.
# Without it, /map falls back to plain "Open in Google Maps" links (no API key required).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional. A vector-rendering Map ID for /map, created at
# https://console.cloud.google.com/google/maps-apis/studio/maps (New Map -> Vector, "Tilt"
# enabled). This is the only way the Google Maps JS API supports a tilted/isometric-style
# perspective - without it, the map stays flat (2D) and uses the CIVIC_MAP_STYLE colors coded in
# VendorMap.tsx instead. NOTE: once set, styling must be configured in the Cloud Console against
# this Map ID - the local color styles are ignored in vector-rendering mode.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
